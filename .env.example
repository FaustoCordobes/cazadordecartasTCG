# Opcional. Sin estas dos, el catálogo se guarda en .data/catalogo.json y no hay reportes, historial ni "más buscadas".
# La service key es SOLO de servidor: nunca la pongas en el código ni en GitHub.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=

# Opcional. Dólar de referencia: bolsa (MEP, por defecto), blue u oficial. Fuente: dolarapi.com
DOLAR_TIPO=bolsa

# Opcional. Dominio público (para sitemap y links). Por defecto: https://cazadordecartas-tcg.vercel.app
NEXT_PUBLIC_SITE_URL=

# Opcional. Avisos al celular (notificaciones push). Generá las dos claves UNA vez con:
#   npx web-push generate-vapid-keys
# Van en Vercel (Environment Variables) y en GitHub (Settings → Secrets → Actions). La privada nunca en el código.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto para los servicios de notificaciones: tu web o mailto:tu@email
VAPID_SUBJECT=https://cazadordecartas-tcg.vercel.app

# Opcional. Cuentas de usuario (mail + contraseña, sin confirmar el mail).
# Supabase → Project Settings → API Keys: la "Publishable key" (sb_publishable_...) es pública y va en el navegador.
# (NO uses acá la secret key.) En Supabase desactivá Authentication → Sign In / Providers → Email → "Confirm email".
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Opcional. Botón "Continuar con Google" (primero activá Google en Supabase → Authentication → Sign In / Providers). Poné 1 para mostrarlo.
NEXT_PUBLIC_GOOGLE_LOGIN=
